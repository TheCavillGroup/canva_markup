{
    "name": "@thecavillgroup/canva-markup",
    "version": "0.5.0",
    "license": "MIT",
    "exports": {
        ".": "./mod.ts",
        "./canva": "./canva/mod.ts"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@^1.0.14",
        "@canva/design": "npm:@canva/design@2.13.2-beta.0",
        "@canva/asset": "npm:@canva/asset@^2.3.1",
        "@thecavillgroup/canva-textmetrics": "jsr:@thecavillgroup/canva-textmetrics@^0.2.0",
        "@std/testing": "jsr:@std/testing@^1.0.0"
    },
    "publish": {
        "exclude": [
            "tests/"
        ]
    },
    "tasks": {
        "test": "deno test --allow-read",
        "dry": "deno publish --dry-run --allow-dirty",
        "check": "deno check mod.ts canva/mod.ts && deno check --doc-only docs/EXAMPLES.md"
    },
    "compilerOptions": {
        "lib": [
            "deno.ns",
            "dom",
            "dom.iterable",
            "esnext"
        ]
    }
}
